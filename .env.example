# Salin ke .env lalu isi nilainya:  cp .env.example .env
MASTER_HOST=
MASTER_PORT=22
MASTER_USER=
MASTER_PASS=

BACKUP_HOST=
BACKUP_PORT=22
BACKUP_USER=
BACKUP_PASS=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dipakai mode --auto: jam sync harian (jaring pengaman), format HH:MM, 24 jam
DAILY_SYNC_TIME=00:00

# Cara commit-trigger (--watch / --auto) mengirim perubahan ke Backup:
#   patch (default) → kirim DELTA saja via `load patch` (compare rollback 1);
#                     fallback otomatis ke load merge full bila patch ditolak
#   merge           → perilaku lama: kirim seluruh stanza + load merge (aditif)
COMMIT_TRIGGER_MODE=patch

# Cara mengirim config ke Backup:
#   sftp (default) → upload file via SFTP lalu `load merge <file>`. Paling andal
#                    untuk config besar. Butuh `set system services ssh
#                    sftp-server` aktif di Backup.
#   terminal       → paste isi config via `load merge terminal` (baris demi
#                    baris). Dipakai bila SFTP tak tersedia.
TRANSFER_MODE=sftp

# Nama logical-systems yang HANYA ada di Backup (mis. standby VRRP yang
# di-`deactivate`) dan TIDAK boleh disentuh sync. Saat `--full` (mirror), LS ini
# tidak ikut dihapus → isi config & status deactivate-nya tetap utuh di Backup.
# Dipisah koma. Kosongkan bila tak ada. Contoh:
# PRESERVE_LOGICAL_SYSTEMS=BGP-SCRIPT
PRESERVE_LOGICAL_SYSTEMS=

# Mode DIFF (`--diff` atau COMMIT_TRIGGER_MODE=diff): path file pengecualian.
# Config di Backup yang path-nya cocok isi file ini tak pernah ditambah/dihapus.
# Lihat contоh di exclude.conf.example. Default: exclude.conf
EXCLUDE_FILE=exclude.conf
